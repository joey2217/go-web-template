# 环境变量以 APP_ 为前缀，可覆盖 config.yaml 中的任意配置项。
# 命名规则：层级用下划线连接，例如 database.host -> APP_DATABASE_HOST。
# 复制为 .env 后按需修改（.env 不提交仓库）。

APP_APP_ENV=dev

APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=5432
APP_DATABASE_USER=postgres
APP_DATABASE_PASSWORD=postgres
APP_DATABASE_NAME=app

APP_REDIS_ADDR=localhost:6379
# Redis 密码：必须与 docker-compose.yml 中 redis 服务的 --requirepass 一致。
# 开发默认是 redis（compose 已硬编码）；生产请改成强密码并同步两边。
APP_REDIS_PASSWORD=redis
APP_REDIS_DB=0
